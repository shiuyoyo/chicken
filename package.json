{
  "name": "food-factory-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "schema": "node scripts/gen-schema.mjs",
    "test": "vitest run",
    "e2e": "node tests/e2e/acceptance.cjs",
    "test:functions": "cd supabase/functions && deno test tests/",
    "e2e:cloud": "node tests/e2e/cloud.cjs",
    "test:replay": "vitest run --config vitest.replay.config.js",
    "e2e:flows": "node tests/e2e/flows.cjs local",
    "e2e:flows:cloud": "node tests/e2e/flows.cjs cloud",
    "e2e:offline": "node tests/e2e/offline-app.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
